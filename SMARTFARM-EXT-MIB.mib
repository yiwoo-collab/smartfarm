sfPump OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Water pump."
    ::= { sfControl 7 }

sfCover OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Shade cover (0 open, 1 closed, simulated)."
    ::= { sfControl 8 }

sfLights OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Greenhouse lights (simulated)."
    ::= { sfControl 9 }

sfControlMode OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Control mode (0 manual, 1 auto)."
    ::= { sfControl 10 }

-- Settings (read-write)

sfNightMode OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Night mode enabled."
    ::= { sfControl 11 }

sfNightStart OBJECT-TYPE
    SYNTAX      Integer32
    UNITS       "min"
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Night mode start (minutes after midnight)."
    ::= { sfControl 12 }

sfNightEnd OBJECT-TYPE
    SYNTAX      Integer32
    UNITS       "min"
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Night mode end (minutes after midnight)."
    ::= { sfControl 13 }

sfAiMode OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "AI mode (0 demo, 1 live)."
    ::= { sfControl 14 }

sfAlarmMessage OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  accessible-for-notify
    STATUS      current
    DESCRIPTION "Alarm or clear message (UTF-8)"
    ::= { sfTrapObjects 1 }

farmAlarm NOTIFICATION-TYPE
    OBJECTS     { sfAlarmLevel, sfAlarmCode, sfAlarmMessage }
    STATUS      current
    DESCRIPTION "Farm alarm raised or cleared by the Pi (level, code, message)"
    ::= { sfTraps 1 }

END
