PELKOREA-RMU-MIB DEFINITIONS ::= BEGIN

IMPORTS
    MODULE-IDENTITY, OBJECT-TYPE, NOTIFICATION-TYPE, Integer32, enterprises
        FROM SNMPv2-SMI;

pelkorea MODULE-IDENTITY
    LAST-UPDATED "202610310000Z"
    ORGANIZATION "PELKOREA"
    CONTACT-INFO
        "R&D Team
        Phone: +82-2-6112-3730
        Email: info@pelkorea.com"
    DESCRIPTION
        "MIB for PELKOREA RMU Device (SNMPv2c Compatible).
        Not every object is available on every installation. Objects of devices that
        are not installed or not enabled for the site respond with noSuchObject."
    REVISION "202610310000Z"
    DESCRIPTION
        "Added availability notes (objects may be absent depending on the site
        configuration)."
    REVISION "202610280000Z"
    DESCRIPTION
        "Added ctrStatus2 (VTES 2). Alarm codes changed: 81 = VTES2 and
        CCTV1-CCTV5 moved from 81-85 to 82-86."
    REVISION "202610220000Z"
    DESCRIPTION
        "Added cctvTable index (cctvIndex), vtes group, upsShutdown and alarm
        code table.
        Corrected IMPORTS, value ranges and value descriptions."
    REVISION "202501080000Z"
    DESCRIPTION
        "Initial version."
    ::= { enterprises 61123730 }

-- Root Object Identifiers
rmu      OBJECT IDENTIFIER ::= { pelkorea 1 }
base     OBJECT IDENTIFIER ::= { rmu 1 }
setup    OBJECT IDENTIFIER ::= { rmu 2 }
ups      OBJECT IDENTIFIER ::= { rmu 3 }
trap     OBJECT IDENTIFIER ::= { rmu 4 }
external  OBJECT IDENTIFIER ::= { rmu 5 }
cctv      OBJECT IDENTIFIER ::= { external 1 }
vtes      OBJECT IDENTIFIER ::= { external 2 }

-- Base Group
acv1 OBJECT-TYPE
    SYNTAX      Integer32 (0..2700)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "AC1 Voltage (0-2700). display value = acv1 / 10"
    ::= { base 1 }

acv2 OBJECT-TYPE
    SYNTAX      Integer32 (0..2700)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "AC2 Voltage (0-2700). display value = acv2 / 10"
    ::= { base 2 }

dcv1 OBJECT-TYPE
    SYNTAX      Integer32 (0..800)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "DCV1 Voltage (0-800). display value = dcv1 / 10"
    ::= { base 3 }

dcv2 OBJECT-TYPE
    SYNTAX      Integer32 (0..800)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "DCV2 Voltage (0-800). display value = dcv2 / 10"
    ::= { base 4 }

ach1 OBJECT-TYPE
    SYNTAX      Integer32 (0..700)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "AC1 Frequency (0-700). display value = ach1 / 10"
    ::= { base 5 }

ach2 OBJECT-TYPE
    SYNTAX      Integer32 (0..700)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "AC2 Frequency (0-700). display value = ach2 / 10"
    ::= { base 6 }

acdci1 OBJECT-TYPE
    SYNTAX      Integer32 (0..800)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "ACDCI1 AC Current (0-800). display value = acdci1 / 10"
    ::= { base 7 }

acdci2 OBJECT-TYPE
    SYNTAX      Integer32 (0..800)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "ACDCI2 DC Current (0-800). display value = acdci2 / 10"
    ::= { base 8 }

temp1 OBJECT-TYPE
    SYNTAX      Integer32 (0..2000)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "TEMP1 temperature (0-2000). display value = (temp1 - 500) / 10"
    ::= { base 9 }

temp2 OBJECT-TYPE
    SYNTAX      Integer32 (0..2000)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "TEMP2 temperature (0-2000). display value = (temp2 - 500) / 10"
    ::= { base 10 }

temp3 OBJECT-TYPE
    SYNTAX      Integer32 (0..2000)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "TEMP3 temperature (0-2000). display value = (temp3 - 500) / 10"
    ::= { base 11 }

temp4 OBJECT-TYPE
    SYNTAX      Integer32 (0..2000)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "TEMP4 temperature (0-2000). display value = (temp4 - 500) / 10"
    ::= { base 12 }

humidity1 OBJECT-TYPE
    SYNTAX      Integer32 (0..1000)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "HUMIDITY1 Humidity (0-1000). display value = humidity1 / 10"
    ::= { base 13 }

humidity2 OBJECT-TYPE
    SYNTAX      Integer32 (0..1000)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "HUMIDITY2 Humidity (0-1000). display value = humidity2 / 10"
    ::= { base 14 }

pm10 OBJECT-TYPE
    SYNTAX Integer32 (0..1000)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Particulate Matter 10 (0-1000)."
    ::= { base 15 }

pm25 OBJECT-TYPE
    SYNTAX Integer32 (0..1000)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Particulate Matter 2.5 (0-1000)."
    ::= { base 16 }

pm1 OBJECT-TYPE
    SYNTAX Integer32 (0..1000)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Particulate Matter 1.0 (0-1000)."
    ::= { base 17 }

co2 OBJECT-TYPE
    SYNTAX Integer32 (0..5000)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "CO2 ppm (0-5000)."
    ::= { base 18 }

voc OBJECT-TYPE
    SYNTAX Integer32 (0..3)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Volatile Organic Compounds Level (0-3)."
    ::= { base 19 }

fire OBJECT-TYPE
    SYNTAX Integer32 (0..1)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Fire Detection Sensor (0 = fire detected, 1 = normal). Default 1."
    ::= { base 20 }

doorFront OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Front Door (0 = close, 1 = open). Default sensor type; the polarity may be reversed
                depending on the sensor type (normally open / normally closed)."
    ::= { base 21 }

doorRear OBJECT-TYPE
    SYNTAX Integer32 (0..1)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Rear Door (0 = close, 1 = open). Default sensor type; the polarity may be reversed
                depending on the sensor type (normally open / normally closed)."
    ::= { base 22 }

flood OBJECT-TYPE
    SYNTAX Integer32 (0..1)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Flood Detection (0 = flood, 1 = normal). Default sensor type; the polarity may be reversed
                depending on the sensor type (normally open / normally closed)."
    ::= { base 23 }

fan OBJECT-TYPE
    SYNTAX Integer32 (0..1)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Fan Status (0 = stop, 1 = start). Default sensor type; the polarity may be reversed
                depending on the sensor type (normally open / normally closed)."
    ::= { base 24 }

rectifier OBJECT-TYPE
    SYNTAX Integer32 (0..1)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Rectifier Status (0 = fail, 1 = normal). Default sensor type; the polarity may be reversed
                depending on the sensor type (normally open / normally closed)."
    ::= { base 25 }

ext1 OBJECT-TYPE
    SYNTAX Integer32 (0..1)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "External 1 Status (0 = event, 1 = normal). Default 1."
    ::= { base 26 }

ext2 OBJECT-TYPE
    SYNTAX Integer32 (0..1)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "External 2 Status (0 = event, 1 = normal). Default 1."
    ::= { base 27 }

shock OBJECT-TYPE
    SYNTAX Integer32 (0..1)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Shock Detection (0 = normal, 1 = shock). Default sensor type; the polarity may be reversed
                depending on the sensor type (normally open / normally closed)."
    ::= { base 28 }

alarm OBJECT-TYPE
    SYNTAX Integer32 (0..255)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Alarm code (0-255).
                Codes 1-28 correspond to the sub-identifier of the base object
                that raised the alarm (e.g. 1 = acv1, 9 = temp1, 21 = doorFront).
                Other codes: 48 = CTR_FIRE, 50 = CTR_XK2, 51 = CTR_XK3,
                60 = UPS utility fail, 61 = UPS battery low,
                62 = UPS bypass/buck, 63 = UPS fault, 64 = UPS type,
                65 = UPS test, 66 = UPS shutdown, 80 = VTES,
                81 = VTES2, 82-86 = CCTV1-CCTV5,
                98 = UPS communication failure.
                Adding 100 to a code (101-198) means the alarm is released.
                The codes actually sent as traps depend on the site configuration."
    ::= { base 29 }

