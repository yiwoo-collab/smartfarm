-- UPS Group
upsIpv OBJECT-TYPE
    SYNTAX      Integer32 (0..2640)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Input Voltage (0-2640). display value = upsIpv / 10"
    ::= { ups 1 }

upsIpfv OBJECT-TYPE
    SYNTAX      Integer32 (0..2640)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Input Fault Voltage (0-2640). display value = upsIpfv / 10"
    ::= { ups 2 }

upsOpv OBJECT-TYPE
    SYNTAX      Integer32 (0..2640)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Output Voltage (0-2640). display value = upsOpv / 10"
    ::= { ups 3 }

upsOpc OBJECT-TYPE
    SYNTAX      Integer32 (0..100)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Load ratio in percent (0-100)."
    ::= { ups 4 }

upsIpf OBJECT-TYPE
    SYNTAX      Integer32 (450..650)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Input Frequency (450-650). display value = upsIpf / 10"
    ::= { ups 5 }

upsBv OBJECT-TYPE
    SYNTAX      Integer32 (0..150)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Battery Voltage (0-150). display value = upsBv / 10"
    ::= { ups 6 }

upsTm OBJECT-TYPE
    SYNTAX      Integer32 (0..500)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Temperature (0-500). display value = upsTm / 10"
    ::= { ups 7 }

upsAv OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Utility Fail (abnormal voltage electricity) (0 = normal, 1 = utility fail)."
    ::= { ups 8 }

upsBl OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Battery Low (0 = normal, 1 = battery low)."
    ::= { ups 9 }

upsBb OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Bypass/Boost or Buck Active (0 = normal, 1 = active)."
    ::= { ups 10 }

upsUf OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Failed (0 = normal, 1 = failed)."
    ::= { ups 11 }

upsUs OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Type (0 = on-line, 1 = standby)."
    ::= { ups 12 }

upsTs OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Test in Progress (0 = idle, 1 = test in progress)."
    ::= { ups 13 }

upsSt OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS Shutdown Active (0 = normal, 1 = shutdown active)."
    ::= { ups 14 }

upsBz OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "UPS communication failure (0 = normal, 1 = communication failure). Formerly Beeper On."
    ::= { ups 15 }

upsShutdown OBJECT-TYPE
    SYNTAX      OCTET STRING (SIZE (3..6))
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "UPS Shutdown Output off and Restore command.
                Format is 's,r' (digits and a single comma only, no spaces,
                no leading zeros) where s is the shutdown delay in minutes
                (1-10) and r is the restore delay in minutes (1-240).
                Example: '10,240'.
                A value outside these ranges or in any other format is
                rejected (wrongValue).
                GET returns the last value received; the initial value is '0,0'."
    ::= { ups 16 }

-- Trap Group
addTrap OBJECT-TYPE
    SYNTAX      OCTET STRING (SIZE (0..255))
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "Adds a trap destination as an OctetString. Format: 'IP:Port' (e.g., '192.168.1.100:162')."
    ::= { trap 1 }

alarmTrap NOTIFICATION-TYPE
    OBJECTS { alarm }
    STATUS current
    DESCRIPTION "Trap to notify an alarm status change. The alarm object carries the alarm code."
    ::= { trap 2 }

-- External Group
cctvTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF CctvEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "Table representing the status of up to 5 IP cameras.
                Available only when CCTV monitoring is enabled for the site;
                otherwise the objects of this table respond with noSuchObject."
    ::= { cctv 1 }

cctvEntry OBJECT-TYPE
    SYNTAX      CctvEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "A CCTV (IP camera) entry."
    INDEX       { cctvIndex }
    ::= { cctvTable 1 }

CctvEntry ::= SEQUENCE {
        cctvName           OCTET STRING,
        cctvStatus         Integer32,
        cctvIndex          Integer32
    }

cctvName OBJECT-TYPE
    SYNTAX      OCTET STRING (SIZE (0..255))
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CCTV Name"
    ::= { cctvEntry 1 }

cctvStatus OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Status of CCTV. Each value is 0 (active) or 1 (inactive)."
    ::= { cctvEntry 2 }

cctvIndex OBJECT-TYPE
    SYNTAX      Integer32 (1..5)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "Index of the CCTV (1-5)."
    ::= { cctvEntry 3 }

ctrStatus OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Status of Controller (VTES 1). Each value is 0 (active) or 1 (inactive).
                Available only when VTES 1 is installed and enabled for the site;
                otherwise noSuchObject."
    ::= { vtes 1 }

ctrStatus2 OBJECT-TYPE
    SYNTAX      Integer32 (0..1)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Status of Controller (VTES 2). Each value is 0 (active) or 1 (inactive).
                Available only when VTES 2 is installed and enabled for the site;
                otherwise noSuchObject."
    ::= { vtes 2 }

END