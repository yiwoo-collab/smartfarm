setAcv1Uvt OBJECT-TYPE
    SYNTAX      Integer32 (1760..2150)
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "AC1 Voltage Lower Threshold (1760-2150). display value = setAcv1Uvt / 10"
    ::= { setup 1 }

setAcv1Ovt OBJECT-TYPE
    SYNTAX      Integer32 (2250..2640)
    MAX-ACCESS  read-write
    STATUS      current
    DESCRIPTION "AC1 Voltage Upper Threshold (2250-2640). display value = setAcv1Ovt / 10"
