    ::= { setup 13 }

setHumiO OBJECT-TYPE
    SYNTAX Integer32 (400..1000)
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION "Settable Humidity Over Threshold (400-1000). display value = setHumiO / 10"
    ::= { setup 14 }

setPm10O OBJECT-TYPE
    SYNTAX Integer32 (0..1000)
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION "Settable PM10 Over Threshold (0-1000)."
